{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://club-decide-washington-commercial.trycloudflare.com/api/:path*" },
    { "source": "/img/:path*", "destination": "https://club-decide-washington-commercial.trycloudflare.com/img/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
