QUENYA_DATABASE_URL=
QUENYA_IMAGE_STORE=supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Example Cloudflare account ID: 1145c9774726c54b9310b60020a4dafd
QUENYA_R2_ACCOUNT_ID=
QUENYA_R2_ACCESS_KEY_ID=
QUENYA_R2_SECRET_ACCESS_KEY=
QUENYA_R2_BUCKET=quenya
QUENYA_R2_PUBLIC_URL=

# Set URL and SHA256 for the published ONNX model, or use a file already in /cache.
QUENYA_CLIP_TEXT_URL=https://github.com/baher228/quenya/releases/download/models-clip32-v1/clip-vit-b32-laion2b-text-fp32.onnx
QUENYA_CLIP_TEXT_SHA256=34933acacf265014137756d3e43ea18076117c1334883b4d6eba72fab04fdc7c
# QUENYA_CLIP_TEXT_PATH=/cache/clip-vit-b32-laion2b-text-fp32.onnx

QUENYA_LLM_PROVIDER=cursor
QUENYA_CURSOR_MODEL=gemini-3.7-flash-high
# Cursor model used for stylist tasks.
QUENYA_CURSOR_STYLIST_MODEL=gpt-5.3-codex-low-fast
CURSOR_API_KEY=
QUENYA_CURSOR_TIMEOUT_S=120
QUENYA_CURSOR_BIN=
QUENYA_LLM_DAILY_CAP=300
QUENYA_TAGGER=local

QUENYA_CORS_ORIGINS=https://quenya-rho.vercel.app
QUENYA_RANKER=ab
QUENYA_SHARED_CORE=0
TAVILY_API_KEY=

# Optional OpenAI-compatible fallback:
QUENYA_LLM_API_KEY=
QUENYA_LLM_BASE_URL=https://api.openai.com/v1

# Optional local SQLite path; production should use QUENYA_DATABASE_URL.
# DB_PATH=/cache/quenya.db
# SUPABASE_DB_URL is used by importer/migration tools, not the API service.
# QUENYA_SKIP_DB_INIT is an internal one-shot tool override; leave unset.
