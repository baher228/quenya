# LLM provider: Cursor CLI (default) or OpenAI-compatible API.
QUENYA_LLM_PROVIDER=cursor
QUENYA_CURSOR_MODEL=gemini-3.7-flash-high
CURSOR_API_KEY=
QUENYA_CURSOR_BIN=
QUENYA_CURSOR_TIMEOUT_S=120
QUENYA_LLM_DAILY_CAP=300

# Set QUENYA_LLM_PROVIDER=openai to use the OpenAI-compatible fallback.
QUENYA_LLM_API_KEY=
QUENYA_LLM_BASE_URL=https://api.openai.com/v1

# Product tagging is local by default; set to llm to use the selected provider.
QUENYA_TAGGER=local

TAVILY_API_KEY=
